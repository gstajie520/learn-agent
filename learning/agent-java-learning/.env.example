# Java 侧模型配置模板 —— 全部 Java 模块共用这一份
#
# 用法：把本文件复制成同目录下的 .env，填上真实值。
#   Copy-Item .env.example .env
#
# .env 已被 learning/agent-java-learning/.gitignore 忽略，永不提交。
# 本文件（.env.example）不含任何真实值，可以提交，用来记录「需要配哪几项」。
#
# 变量名与 python/.env 完全一致，Python 和 Java 共用同一套配置，
# 不必维护两份。读取入口是 ModelSettings.fromEnvironmentOrDotEnv()：
# 先读本文件所在目录的 .env，再让操作系统环境变量覆盖同名项
# （与 python-dotenv 的 load_dotenv() 默认行为一致）。
# 所以想临时换个模型跑一次，不用改文件：
#   $env:OPENAI_MODEL = 'deepseek-v4-flash'

# 服务根地址。注意：不要带 /chat/completions，也不要自己加 /v1。
# 客户端只会追加 /chat/completions，与 Python OpenAI SDK 的行为一致。
# 如果你的服务商确实需要 /v1，把它写进这里，例如 https://host/v1
OPENAI_BASE_URL=https://api.deepseek.com

# 服务商密钥。绝不写进代码、日志或 Git。
OPENAI_API_KEY=sk-在这里填你的密钥

# 默认模型名。
OPENAI_MODEL=deepseek-v4-flash
